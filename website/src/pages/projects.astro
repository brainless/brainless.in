---
import Layout from '../layouts/Page.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
---

<Layout title="Software Projects - Open Source & Startup Work" description="Explore Sumit's software projects including open source contributions, startup MVPs, and development tools. Built with Python, React, Node.js and modern technologies.">
	<div class="max-w-3xl mx-auto max-[720px]:max-w-[calc(100%-0.5rem)]">
		{projects.map(project => (
			<ProjectCard project={project} />
		))}
	</div>
</Layout>
