---
export interface Project {
	name: string;
	description: string | null;
	url: string;
	stars: number;
	languages: Record<string, number>;
	summary: string;
	last_updated: string;
}

export interface Props {
	project: Project;
}

const { project } = Astro.props;

const topLanguages = Object.entries(project.languages)
	.sort(([, a], [, b]) => b - a)
	.slice(0, 3)
	.map(([lang]) => lang);
---

<div class="rounded-md border border-border p-5">
    <div class="mb-2 flex items-center justify-between gap-3">
        <h3 class="font-serif text-xl font-semibold">
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary">
                {project.name}
            </a>
        </h3>
        <span class="rounded-full border border-border px-2 py-0.5 text-xs font-medium text-muted-foreground">Public</span>
    </div>
    {project.description && <p class="mb-4 text-sm text-muted-foreground">{project.description}</p>}
    <div class="flex flex-col gap-2 text-sm text-muted-foreground sm:flex-row sm:items-center">
        <div class="flex flex-wrap items-center gap-4">
            <div class="flex items-center">
                <svg class="mr-1 h-4 w-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"></path>
                </svg>
                <span>{project.stars}</span>
            </div>
            <div class="flex flex-wrap gap-3">
                {topLanguages.map(lang => (
                    <div class="flex items-center">
                        <span class="mr-2 h-2 w-2 rounded-full bg-muted-foreground"></span>
                        <span>{lang}</span>
                    </div>
                ))}
            </div>
        </div>
        <span class="text-xs sm:ml-auto sm:mt-0">Updated {new Date(project.last_updated).toLocaleDateString()}</span>
    </div>
</div>
