---
export interface Video {
  title: string;
  description: string;
  link: string;
  thumbnail: string;
  publishDate: string;
}

export interface Props {
  video: Video;
}

const { video } = Astro.props;
---

<div class="rounded-md border border-border p-4">
  <a href={video.link} target="_blank" rel="noopener noreferrer" class="block overflow-hidden rounded-md bg-muted">
    <img
      src={video.thumbnail}
      alt={video.title}
      width="480"
      height="270"
      loading="lazy"
      class="aspect-video w-full object-cover"
    />
  </a>
  <h3 class="mt-3 font-serif text-lg font-semibold leading-snug">
    <a href={video.link} target="_blank" rel="noopener noreferrer" class="hover:text-primary">
      {video.title}
    </a>
  </h3>
  {video.description && <p class="mb-1 mt-2 text-sm text-muted-foreground">{video.description}</p>}
  <span class="text-xs text-muted-foreground">
    Uploaded on {new Date(video.publishDate).toLocaleDateString()}
  </span>
</div>
